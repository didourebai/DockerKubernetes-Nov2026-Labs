# MAUVAIS ordre -- le pip install se relance a CHAQUE changement de code
# + deux fautes de style detectees par "docker buildx build --check" :
#   "as" en minuscules (FromAsCasing) et "ENV CLE valeur" (LegacyKeyValueFormat)
FROM python:3.12-slim as base
ENV PYTHONUNBUFFERED 1
WORKDIR /app
COPY . .
RUN pip install --no-cache-dir -r requirements.txt
CMD ["python", "app.py"]
